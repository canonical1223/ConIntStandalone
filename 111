# Р’РЅСѓС‚СЂРµРЅРЅРёР№ РјР°РєСЂРѕСЃ: РЅР°Р№С‚Рё QDoc РІ РІС‹Р±СЂР°РЅРЅРѕР№ СѓСЃС‚Р°РЅРѕРІРєРµ Qt.
# QDOC_EXECUTABLE РјРѕР¶РЅРѕ РїРµСЂРµРѕРїСЂРµРґРµР»РёС‚СЊ РїР°СЂР°РјРµС‚СЂРѕРј -DQDOC_EXECUTABLE=...
# -----------------------------------------------------------------------------

macro(_gs_find_qdoc)
    if(QDOC_EXECUTABLE)
        if(NOT EXISTS "${QDOC_EXECUTABLE}")
            message(FATAL_ERROR
                "[Docs] QDOC_EXECUTABLE does not exist: ${QDOC_EXECUTABLE}")
        endif()
    else()
        find_program(_gs_qdoc_candidate
            NAMES qdoc qdoc.exe
            PATHS "${_gs_qt_bin}"
            NO_DEFAULT_PATH
            DOC "Qt QDoc executable")

        if(NOT _gs_qdoc_candidate)
            find_program(_gs_qdoc_candidate_fallback
                NAMES qdoc qdoc.exe
                DOC "Qt QDoc executable")
            if(_gs_qdoc_candidate_fallback)
                set(_gs_qdoc_candidate "${_gs_qdoc_candidate_fallback}")
                message(WARNING
                    "[Docs] qdoc was not found in the selected Qt bin directory; "
                    "using PATH result: ${_gs_qdoc_candidate}")
            endif()
        endif()

        if(NOT _gs_qdoc_candidate)
            message(FATAL_ERROR
                "[Docs] qdoc was not found. Expected it in ${_gs_qt_bin}; "
                "set QDOC_EXECUTABLE to its full path.")
        endif()

        set(QDOC_EXECUTABLE "${_gs_qdoc_candidate}"
            CACHE FILEPATH "Path to the Qt QDoc executable")
    endif()

    message(STATUS "[Docs] QDoc executable    = ${QDOC_EXECUTABLE}")
endmacro()

# -----------------------------------------------------------------------------
# Р’РЅСѓС‚СЂРµРЅРЅРёР№ РјР°РєСЂРѕСЃ: РїРѕРґРіРѕС‚РѕРІРёС‚СЊ PATH РґР»СЏ Р·Р°РїСѓСЃРєР° QDoc.
# РСЃРїРѕР»СЊР·СѓСЋС‚СЃСЏ СЂР°Р·РґРµР»РёС‚РµР»Рё РїСѓС‚РµР№ С‚РµРєСѓС‰РµР№ РїР»Р°С‚С„РѕСЂРјС‹; РєРѕРЅРєСЂРµС‚РЅР°СЏ РІРµСЂСЃРёСЏ Qt
# РёР»Рё MinGW РІ PATH РЅРµ С„РёР»СЊС‚СЂСѓРµС‚СЃСЏ РїРѕ Р·Р°С…Р°СЂРґРєРѕР¶РµРЅРЅРѕРјСѓ С€Р°Р±Р»РѕРЅСѓ.
# -----------------------------------------------------------------------------

macro(_gs_compute_safe_path)
    file(TO_CMAKE_PATH "$ENV{PATH}" _gs_path_entries)

    set(_gs_preferred_path "")
    if(IS_DIRECTORY "${_gs_qt_bin}")
        list(APPEND _gs_preferred_path "${_gs_qt_bin}")
    endif()
    if(_gs_mingw_bin AND IS_DIRECTORY "${_gs_mingw_bin}")
        list(APPEND _gs_preferred_path "${_gs_mingw_bin}")
    endif()

    list(APPEND _gs_preferred_path ${_gs_path_entries})
    list(REMOVE_DUPLICATES _gs_preferred_path)

    # РџСЂРµРѕР±СЂР°Р·СѓРµРј СЃРїРёСЃРѕРє CMake РѕР±СЂР°С‚РЅРѕ РІ С„РѕСЂРјР°С‚ PATH РѕРїРµСЂР°С†РёРѕРЅРЅРѕР№ СЃРёСЃС‚РµРјС‹.
    file(TO_NATIVE_PATH "${_gs_preferred_path}" _gs_safe_path)
    message(STATUS "[Docs] QDoc PATH          = ${_gs_safe_path}")
endmacro()

# -----------------------------------------------------------------------------
# Р’РЅСѓС‚СЂРµРЅРЅСЏСЏ С„СѓРЅРєС†РёСЏ: РїРѕР»СѓС‡РёС‚СЊ AUTOGEN include-РєР°С‚Р°Р»РѕРі С†РµР»Рё.
# РљР°С‚Р°Р»РѕРі РґРѕР±Р°РІР»СЏРµС‚СЃСЏ РґР°Р¶Рµ РґРѕ РµРіРѕ С„РёР·РёС‡РµСЃРєРѕРіРѕ СЃРѕР·РґР°РЅРёСЏ: AUTOGEN-С„Р°Р№Р»С‹
# РїРѕСЏРІР»СЏСЋС‚СЃСЏ РІРѕ РІСЂРµРјСЏ СЃР±РѕСЂРєРё, Р° QDoc Р·Р°РїСѓСЃРєР°РµС‚СЃСЏ РїРѕСЃР»Рµ СЃР±РѕСЂРєРё С†РµР»РµРІРѕР№ Р±РёР±Р»РёРѕС‚РµРєРё.
# -----------------------------------------------------------------------------

function(_gs_get_target_autogen_include _target _out_var)
    set(_result "")

    if(NOT TARGET "${_target}")
        set(${_out_var} "" PARENT_SCOPE)
        return()
    endif()

    get_target_property(_autogen_dir "${_target}" AUTOGEN_BUILD_DIR)

    if(NOT _autogen_dir)
        get_target_property(_automoc "${_target}" AUTOMOC)
        get_target_property(_autouic "${_target}" AUTOUIC)
        get_target_property(_autorcc "${_target}" AUTORCC)

        if(_automoc OR _autouic OR _autorcc)
            get_target_property(_binary_dir "${_target}" BINARY_DIR)
            if(_binary_dir)
                set(_autogen_dir "${_binary_dir}/${_target}_autogen")
            endif()
        endif()
    endif()

    if(_autogen_dir AND NOT _autogen_dir MATCHES "\\$<")
        set(_result "${_autogen_dir}/include")
    endif()

    set(${_out_var} "${_result}" PARENT_SCOPE)
endfunction()

# -----------------------------------------------------------------------------
# Р’РЅСѓС‚СЂРµРЅРЅСЏСЏ С„СѓРЅРєС†РёСЏ: СЂРµРєСѓСЂСЃРёРІРЅС‹Р№ СЃР±РѕСЂ include-РїСѓС‚РµР№ РёР· РіСЂР°С„Р° Р·Р°РІРёСЃРёРјРѕСЃС‚РµР№.
# РћР±СЂР°Р±Р°С‚С‹РІР°РµС‚ INCLUDE_DIRECTORIES, INTERFACE_INCLUDE_DIRECTORIES,
# LINK_LIBRARIES, INTERFACE_LINK_LIBRARIES Рё AUTOGEN_BUILD_DIR.
# -----------------------------------------------------------------------------

function(_gs_collect_includes _target _out_includes _out_visited _visited)
    if(NOT TARGET "${_target}")
        set(${_out_includes} "" PARENT_SCOPE)
        set(${_out_visited} "${_visited}" PARENT_SCOPE)
        return()
    endif()

    if("${_target}" IN_LIST _visited)
        set(${_out_includes} "" PARENT_SCOPE)
        set(${_out_visited} "${_visited}" PARENT_SCOPE)
        return()
    endif()

    list(APPEND _visited "${_target}")
    set(_local_includes "")

    get_target_property(_source_dir "${_target}" SOURCE_DIR)
    get_target_property(_binary_dir "${_target}" BINARY_DIR)

    foreach(_property INCLUDE_DIRECTORIES INTERFACE_INCLUDE_DIRECTORIES)
        get_target_property(_dirs "${_target}" "${_property}")
        if(_dirs)
            foreach(_dir IN LISTS _dirs)
                set(_resolved_dir "")

                if(_dir MATCHES "^\\$<BUILD_INTERFACE:([^>]*)>$")
                    set(_resolved_dir "${CMAKE_MATCH_1}")
                elseif(NOT _dir MATCHES "\\$<")
                    set(_resolved_dir "${_dir}")
                endif()

                if(_resolved_dir)
                    if(NOT IS_ABSOLUTE "${_resolved_dir}")
                        get_filename_component(_resolved_dir
                            "${_resolved_dir}" ABSOLUTE
                            BASE_DIR "${_source_dir}")
                    endif()
                    list(APPEND _local_includes "${_resolved_dir}")
                endif()
            endforeach()
        endif()
    endforeach()

    _gs_get_target_autogen_include("${_target}" _autogen_include)
    if(_autogen_include)
        list(APPEND _local_includes "${_autogen_include}")
    endif()

    foreach(_property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
        get_target_property(_libraries "${_target}" "${_property}")
        if(_libraries)
            foreach(_library IN LISTS _libraries)
                if(_library MATCHES "\\$<"
                   OR _library STREQUAL "debug"
                   OR _library STREQUAL "optimized"
                   OR _library STREQUAL "general"
                   OR NOT TARGET "${_library}")
                    continue()
                endif()

                _gs_collect_includes(
                    "${_library}"
                    _dependency_includes
                    _dependency_visited
                    "${_visited}"
                )
                list(APPEND _local_includes ${_dependency_includes})
                set(_visited "${_dependency_visited}")
            endforeach()
        endif()
    endforeach()

    list(REMOVE_DUPLICATES _local_includes)
    set(${_out_includes} "${_local_includes}" PARENT_SCOPE)
    set(${_out_visited} "${_visited}" PARENT_SCOPE)
endfunction()

# -----------------------------------------------------------------------------
# Р’РЅСѓС‚СЂРµРЅРЅСЏСЏ С„СѓРЅРєС†РёСЏ: СЃРѕР±СЂР°С‚СЊ AUTOGEN include-РїСѓС‚Рё РёР· С‚РµРєСѓС‰РµРіРѕ РєР°С‚Р°Р»РѕРіР°
# Рё РІСЃРµС… РµРіРѕ РїРѕРґРєР°С‚Р°Р»РѕРіРѕРІ. Р­С‚Рѕ РїРѕРєСЂС‹РІР°РµС‚ РІР»РѕР¶РµРЅРЅС‹Рµ С†РµР»Рё, РєРѕС‚РѕСЂС‹Рµ РЅРµ РІС…РѕРґСЏС‚
# РЅР°РїСЂСЏРјСѓСЋ РІ target_link_libraries РѕСЃРЅРѕРІРЅРѕРіРѕ РјРѕРґСѓР»СЏ.
# -----------------------------------------------------------------------------

function(_gs_collect_directory_autogen _directory _out_var)
    set(_result "")

    get_property(_directory_targets
        DIRECTORY "${_directory}" PROPERTY BUILDSYSTEM_TARGETS)

    foreach(_target IN LISTS _directory_targets)
        _gs_get_target_autogen_include("${_target}" _autogen_include)
        if(_autogen_include)
            list(APPEND _result "${_autogen_include}")
        endif()
    endforeach()

    get_property(_subdirectories
        DIRECTORY "${_directory}" PROPERTY SUBDIRECTORIES)

    foreach(_subdirectory IN LISTS _subdirectories)
        _gs_collect_directory_autogen("${_subdirectory}" _sub_autogen)
        list(APPEND _result ${_sub_autogen})
    endforeach()

    list(REMOVE_DUPLICATES _result)
    set(${_out_var} "${_result}" PARENT_SCOPE)
endfunction()

# -----------------------------------------------------------------------------
# Р’РЅСѓС‚СЂРµРЅРЅСЏСЏ С„СѓРЅРєС†РёСЏ: СЃС„РѕСЂРјРёСЂРѕРІР°С‚СЊ Р°СЂРіСѓРјРµРЅС‚С‹ -I РґР»СЏ QDoc.
# -----------------------------------------------------------------------------

function(_gs_build_include_path_args _module_name _qt_headers _mingw_paths _out_args)
    set(_args "")
    set(_regular_includes "")
    set(_autogen_includes "")

    # Р—Р°РіРѕР»РѕРІРєРё СЃС‚Р°РЅРґР°СЂС‚РЅРѕР№ Р±РёР±Р»РёРѕС‚РµРєРё MinGW/GCC.
    foreach(_path IN LISTS _mingw_paths)
        if(_path AND IS_DIRECTORY "${_path}")
            list(APPEND _regular_includes "${_path}")
        endif()
    endforeach()

    # Р—Р°РіРѕР»РѕРІРєРё Qt.
    if(IS_DIRECTORY "${_qt_headers}")
        list(APPEND _regular_includes "${_qt_headers}")
    endif()

    foreach(_qt_module IN LISTS GEOSCHEME_QDOC_QT_MODULES)
        if(IS_DIRECTORY "${_qt_headers}/${_qt_module}")
            list(APPEND _regular_includes "${_qt_headers}/${_qt_module}")
        endif()
    endforeach()

    # Include-РїСѓС‚Рё РѕСЃРЅРѕРІРЅРѕРіРѕ target Рё С‚СЂР°РЅР·РёС‚РёРІРЅС‹С… Р·Р°РІРёСЃРёРјРѕСЃС‚РµР№.
    if(TARGET "${_module_name}")
        _gs_collect_includes(
            "${_module_name}"
            _target_includes
            _visited_targets
            ""
        )
        list(APPEND _regular_includes ${_target_includes})
    else()
        message(WARNING
            "[Docs] ${_module_name}: target not found; target include paths were not collected.")
    endif()

    # AUTOGEN РІСЃРµС… С†РµР»РµР№ РІРЅСѓС‚СЂРё РєР°С‚Р°Р»РѕРіР° РјРѕРґСѓР»СЏ Рё РµРіРѕ РїРѕРґРєР°С‚Р°Р»РѕРіРѕРІ.
    _gs_collect_directory_autogen(
        "${CMAKE_CURRENT_SOURCE_DIR}"
        _directory_autogen_includes
    )
    list(APPEND _autogen_includes ${_directory_autogen_includes})

    list(REMOVE_DUPLICATES _regular_includes)
    list(REMOVE_DUPLICATES _autogen_includes)

    foreach(_path IN LISTS _regular_includes)
        if(IS_DIRECTORY "${_path}")
            list(APPEND _args "-I${_path}")
        endif()
    endforeach()

    # AUTOGEN include РјРѕР¶РµС‚ РµС‰С‘ РЅРµ СЃСѓС‰РµСЃС‚РІРѕРІР°С‚СЊ РЅР° СЌС‚Р°РїРµ РєРѕРЅС„РёРіСѓСЂР°С†РёРё.
    # Р”РѕР±Р°РІР»СЏРµРј СЂР°СЃСЃС‡РёС‚Р°РЅРЅС‹Р№ РїСѓС‚СЊ Р·Р°СЂР°РЅРµРµ: РјРѕРґСѓР»СЊ Р±СѓРґРµС‚ СЃРѕР±СЂР°РЅ РґРѕ Р·Р°РїСѓСЃРєР° QDoc.
    foreach(_path IN LISTS _autogen_includes)
        if(_path)
            list(APPEND _args "-I${_path}")
        endif()
    endforeach()

    list(REMOVE_DUPLICATES _args)

    list(LENGTH _regular_includes _regular_count)
    list(LENGTH _autogen_includes _autogen_count)
    message(STATUS
        "[Docs] ${_module_name}: include paths: ${_regular_count} regular, ${_autogen_count} AUTOGEN")

    set(${_out_args} "${_args}" PARENT_SCOPE)
endfunction()

# -----------------------------------------------------------------------------
# Р’РЅСѓС‚СЂРµРЅРЅСЏСЏ С„СѓРЅРєС†РёСЏ: СЃРѕС…СЂР°РЅРёС‚СЊ Р°СЂРіСѓРјРµРЅС‚С‹ QDoc РІ РґРёР°РіРЅРѕСЃС‚РёС‡РµСЃРєРёР№ С„Р°Р№Р».
# -----------------------------------------------------------------------------

function(_gs_write_qdoc_args_log _log_name _description _args)
    get_filename_component(_log_dir
        "${GEOSCHEME_QDOC_HTML_DIR}/../logs" ABSOLUTE)
    file(MAKE_DIRECTORY "${_log_dir}")

    string(REPLACE ";" "\n" _pretty_args "${_args}")
    file(WRITE "${_log_dir}/${_log_name}"
        "# ${_description}\n"
        "# Generated by GeoSchemeDocs.cmake during CMake configuration.\n\n"
        "${_pretty_args}\n"
    )

    message(STATUS
        "[Docs] QDoc arguments log = ${_log_dir}/${_log_name}")
endfunction()

# -----------------------------------------------------------------------------
# Р’РЅСѓС‚СЂРµРЅРЅРёР№ РјР°РєСЂРѕСЃ: РёРЅРёС†РёР°Р»РёР·РёСЂРѕРІР°С‚СЊ РѕРєСЂСѓР¶РµРЅРёРµ QDoc.
# -----------------------------------------------------------------------------

macro(_gs_initialize_qdoc)
    _gs_compute_qt_env()
    _gs_find_qdoc()
    _gs_compute_safe_path()
endmacro()

# -----------------------------------------------------------------------------
# gs_add_doc_target(MODULE_NAME QDOCCONF_FILENAME)
# Р РµРіРёСЃС‚СЂРёСЂСѓРµС‚ РґРѕРєСѓРјРµРЅС‚Р°С†РёСЋ РѕС‚РґРµР»СЊРЅРѕРіРѕ РјРѕРґСѓР»СЏ.
# -----------------------------------------------------------------------------

function(gs_add_doc_target MODULE_NAME QDOCCONF_FILENAME)
    # РџРѕР·РІРѕР»СЏРµС‚ Р±РµР·СѓСЃР»РѕРІРЅРѕ РІС‹Р·С‹РІР°С‚СЊ С„СѓРЅРєС†РёСЋ РёР· CMakeLists.txt, РµСЃР»Рё РґРѕРєСѓРјРµРЅС‚Р°С†РёСЏ
    # РѕС‚РєР»СЋС‡РµРЅР°. QDoc РЅРµ РёС‰РµС‚СЃСЏ, С†РµР»Рё РЅРµ СЃРѕР·РґР°СЋС‚СЃСЏ.
    if(NOT GEOSCHEME_BUILD_DOCS)
        return()
    endif()

    if("${MODULE_NAME}" STREQUAL "" OR "${QDOCCONF_FILENAME}" STREQUAL "")
        message(FATAL_ERROR
            "[Docs] gs_add_doc_target requires MODULE_NAME and QDOCCONF_FILENAME.")
    endif()

    if(TARGET "docs_${MODULE_NAME}")
        message(FATAL_ERROR
            "[Docs] Documentation target docs_${MODULE_NAME} is already registered.")
    endif()

    _gs_initialize_qdoc()

    get_filename_component(_gs_qdoc_root
        "${GEOSCHEME_QDOC_ROOT}" ABSOLUTE
        BASE_DIR "${CMAKE_SOURCE_DIR}")
    get_filename_component(_gs_html_root
        "${GEOSCHEME_QDOC_HTML_DIR}" ABSOLUTE
        BASE_DIR "${CMAKE_SOURCE_DIR}")

    if(IS_ABSOLUTE "${QDOCCONF_FILENAME}")
        set(_gs_mod_conf "${QDOCCONF_FILENAME}")
    else()
        get_filename_component(_gs_mod_conf
            "${QDOCCONF_FILENAME}" ABSOLUTE
            BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    endif()

    if(NOT EXISTS "${_gs_mod_conf}")
        message(FATAL_ERROR
            "[Docs] ${MODULE_NAME}: QDoc configuration was not found: ${_gs_mod_conf}")
    endif()

    set(_gs_out_dir "${_gs_html_root}/${MODULE_NAME}")
    set(_gs_stamp "${_gs_out_dir}/.cmake_docs_stamp")

    set(_gs_mingw_paths
        "${_gs_mingw_cxx}"
        "${_gs_mingw_cxx_arch}"
        "${_gs_mingw_cxx_back}"
        "${_gs_mingw_inc}"
        "${_gs_mingw_sys}"
    )

    _gs_build_include_path_args(
        "${MODULE_NAME}"
        "${_gs_qt_headers}"
        "${_gs_mingw_paths}"
        _gs_include_path_args
    )

    _gs_write_qdoc_args_log(
        "${MODULE_NAME}_qdoc_args.txt"
        "QDoc -I arguments for module ${MODULE_NAME}"
        "${_gs_include_path_args}"
    )

    message(STATUS "[Docs] ${MODULE_NAME}: output = ${_gs_out_dir}")
    message(STATUS "[Docs] ${MODULE_NAME}: config = ${_gs_mod_conf}")

    add_custom_command(
        OUTPUT "${_gs_stamp}"
        COMMAND "${CMAKE_COMMAND}" -E make_directory "${_gs_out_dir}"
        COMMAND "${CMAKE_COMMAND}" -E env
            "QT_INSTALL_DOCS=${_gs_qt_docs}"
            "QT_INSTALL_HEADERS=${_gs_qt_headers}"
            "QT_INSTALL_PREFIX=${_gs_qt_root}"
            "QT_VERSION=${_gs_qt_version}"
            "QT_VER=${_gs_qt_version}"
            "MINGW_CXX=${_gs_mingw_cxx}"
            "MINGW_CXX_ARCH=${_gs_mingw_cxx_arch}"
            "MINGW_CXX_BACK=${_gs_mingw_cxx_back}"
            "MINGW_INC=${_gs_mingw_inc}"
            "MINGW_SYS=${_gs_mingw_sys}"
            "INCLUDE="
            "CPLUS_INCLUDE_PATH="
            "C_INCLUDE_PATH="
            "PATH=${_gs_safe_path}"
            "QDOC_DISABLE_CLANG=1"
            "${QDOC_EXECUTABLE}"
            --no-link-errors
            ${_gs_include_path_args}
            "${_gs_mod_conf}"
        COMMAND "${CMAKE_COMMAND}" -E touch "${_gs_stamp}"
        DEPENDS "${_gs_mod_conf}" "${QDOC_EXECUTABLE}"
        WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
        COMMENT "[Docs] QDoc: ${MODULE_NAME}"
        VERBATIM
    )

    add_custom_target("docs_${MODULE_NAME}"
        DEPENDS "${_gs_stamp}")

    # РЎРЅР°С‡Р°Р»Р° СЃРѕР±РёСЂР°РµС‚СЃСЏ СЃР°Рј РјРѕРґСѓР»СЊ: QDoc РјРѕР¶РµС‚ С‡РёС‚Р°С‚СЊ AUTOGEN-С„Р°Р№Р»С‹.
    if(TARGET "${MODULE_NAME}")
        add_dependencies("docs_${MODULE_NAME}" "${MODULE_NAME}")
    endif()

    add_custom_target("docs_${MODULE_NAME}_rebuild"
        COMMAND "${CMAKE_COMMAND}" -E remove_directory "${_gs_out_dir}"
        COMMAND "${CMAKE_COMMAND}" --build "${CMAKE_BINARY_DIR}"
            --config "$<CONFIG>"
            --target "docs_${MODULE_NAME}"
        COMMENT "[Docs] Force rebuild docs: ${MODULE_NAME}"
        VERBATIM
    )

    set_property(GLOBAL APPEND PROPERTY
        GS_DOC_MODULE_TARGETS "docs_${MODULE_NAME}")
    set_property(GLOBAL APPEND PROPERTY
        GS_DOC_MODULE_STAMPS "${_gs_stamp}")
    set_property(GLOBAL APPEND PROPERTY
        GS_DOC_MODULE_NAMES "${MODULE_NAME}")
endfunction()

# -----------------------------------------------------------------------------
# gs_finalize_doc_index()
# Р’С‹Р·С‹РІР°РµС‚СЃСЏ РїРѕСЃР»Рµ РІСЃРµС… add_subdirectory() РІ РєРѕСЂРЅРµРІРѕРј CMakeLists.txt.
# -----------------------------------------------------------------------------

function(gs_finalize_doc_index)
    if(NOT GEOSCHEME_BUILD_DOCS)
        return()
    endif()

    if(TARGET docs_GeoScheme_index)
        message(FATAL_ERROR
            "[Docs] gs_finalize_doc_index() has already been called.")
    endif()

    _gs_initialize_qdoc()

    get_filename_component(_gs_html_root
        "${GEOSCHEME_QDOC_HTML_DIR}" ABSOLUTE
        BASE_DIR "${CMAKE_SOURCE_DIR}")
    get_filename_component(_gs_main_conf
        "${GEOSCHEME_QDOC_INDEX_CONFIG}" ABSOLUTE
        BASE_DIR "${CMAKE_SOURCE_DIR}")

    if(NOT EXISTS "${_gs_main_conf}")
        message(FATAL_ERROR
            "[Docs] Main QDoc configuration was not found: ${_gs_main_conf}")
    endif()

    get_filename_component(_gs_main_conf_dir
        "${_gs_main_conf}" DIRECTORY)

    set(_gs_out_dir "${_gs_html_root}/GeoScheme")
    set(_gs_stamp "${_gs_out_dir}/.cmake_docs_stamp")

    get_property(_gs_module_targets GLOBAL PROPERTY GS_DOC_MODULE_TARGETS)
    get_property(_gs_module_stamps GLOBAL PROPERTY GS_DOC_MODULE_STAMPS)

    message(STATUS
        "[Docs] GeoScheme index: registered modules = ${_gs_module_targets}")
    message(STATUS "[Docs] GeoScheme index: output = ${_gs_out_dir}")
    message(STATUS "[Docs] GeoScheme index: config = ${_gs_main_conf}")

    set(_gs_mingw_paths
        "${_gs_mingw_cxx}"
        "${_gs_mingw_cxx_arch}"
        "${_gs_mingw_cxx_back}"
        "${_gs_mingw_inc}"
        "${_gs_mingw_sys}"
    )

    # Р”Р»СЏ РѕР±С‰РµРіРѕ РёРЅРґРµРєСЃР° РЅРµС‚ РѕРґРЅРѕРіРѕ РѕСЃРЅРѕРІРЅРѕРіРѕ target, РїРѕСЌС‚РѕРјСѓ РёСЃРїРѕР»СЊР·СѓСЋС‚СЃСЏ
    # РѕР±С‰РёРµ include-РєР°С‚Р°Р»РѕРіРё Qt Рё РєРѕРјРїРёР»СЏС‚РѕСЂР°.
    set(_gs_index_include_args "")
    foreach(_path IN LISTS _gs_mingw_paths)
        if(_path AND IS_DIRECTORY "${_path}")
            list(APPEND _gs_index_include_args "-I${_path}")
        endif()
    endforeach()

    if(IS_DIRECTORY "${_gs_qt_headers}")
        list(APPEND _gs_index_include_args "-I${_gs_qt_headers}")
    endif()

    foreach(_qt_module IN LISTS GEOSCHEME_QDOC_QT_MODULES)
        if(IS_DIRECTORY "${_gs_qt_headers}/${_qt_module}")
            list(APPEND _gs_index_include_args
                "-I${_gs_qt_headers}/${_qt_module}")
        endif()
    endforeach()

    list(REMOVE_DUPLICATES _gs_index_include_args)

    _gs_write_qdoc_args_log(
        "GeoScheme_index_qdoc_args.txt"
        "QDoc -I arguments for the GeoScheme main index"
        "${_gs_index_include_args}"
    )

    add_custom_command(
        OUTPUT "${_gs_stamp}"
        COMMAND "${CMAKE_COMMAND}" -E make_directory "${_gs_out_dir}"
        COMMAND "${CMAKE_COMMAND}" -E env
            "QT_INSTALL_DOCS=${_gs_qt_docs}"
            "QT_INSTALL_HEADERS=${_gs_qt_headers}"
            "QT_INSTALL_PREFIX=${_gs_qt_root}"
            "QT_VERSION=${_gs_qt_version}"
            "QT_VER=${_gs_qt_version}"
            "MINGW_CXX=${_gs_mingw_cxx}"
            "MINGW_CXX_ARCH=${_gs_mingw_cxx_arch}"
            "MINGW_CXX_BACK=${_gs_mingw_cxx_back}"
            "MINGW_INC=${_gs_mingw_inc}"
            "MINGW_SYS=${_gs_mingw_sys}"
            "INCLUDE="
            "CPLUS_INCLUDE_PATH="
            "C_INCLUDE_PATH="
            "PATH=${_gs_safe_path}"
            "QDOC_DISABLE_CLANG=1"
            "${QDOC_EXECUTABLE}"
            --no-link-errors
            ${_gs_index_include_args}
            "${_gs_main_conf}"
        COMMAND "${CMAKE_COMMAND}" -E touch "${_gs_stamp}"
        DEPENDS "${_gs_main_conf}" "${QDOC_EXECUTABLE}" ${_gs_module_stamps}
        WORKING_DIRECTORY "${_gs_main_conf_dir}"
        COMMENT "[Docs] QDoc: GeoScheme index"
        VERBATIM
    )

    add_custom_target(docs_GeoScheme_index
        DEPENDS "${_gs_stamp}")

    if(_gs_module_targets)
        add_dependencies(docs_GeoScheme_index ${_gs_module_targets})
    endif()

    add_custom_target(docs_rebuild_all
        COMMAND "${CMAKE_COMMAND}" -E remove_directory "${_gs_html_root}"
        COMMAND "${CMAKE_COMMAND}" --build "${CMAKE_BINARY_DIR}"
            --config "$<CONFIG>"
            --target docs_GeoScheme_index
        COMMENT "[Docs] Full documentation rebuild from scratch"
        VERBATIM
    )
endfunction()
