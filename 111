# -----------------------------------------------------------------------------
# Р’РЅСѓС‚СЂРµРЅРЅРёР№ РјР°РєСЂРѕСЃ: РѕРїСЂРµРґРµР»РёС‚СЊ Qt root, include Рё РєР°С‚Р°Р»РѕРі РґРѕРєСѓРјРµРЅС‚Р°С†РёРё.
# РќРµ Р·Р°РІРёСЃРёС‚ РѕС‚ LOCATION РёРјРїРѕСЂС‚РёСЂРѕРІР°РЅРЅРѕР№ С†РµР»Рё Qt5::Core.
# -----------------------------------------------------------------------------

macro(_gs_compute_qt_env)
    find_package(Qt5 REQUIRED COMPONENTS Core)

    if(NOT Qt5Core_DIR)
        message(FATAL_ERROR
            "[Docs] Qt5Core_DIR is not defined. Cannot determine the Qt installation.")
    endif()

    # РўРёРїРёС‡РЅР°СЏ СЃС‚СЂСѓРєС‚СѓСЂР° Qt Online Installer:
    # <Qt-kit>/lib/cmake/Qt5Core/Qt5CoreConfig.cmake
    # РЈ СЃРёСЃС‚РµРјРЅС‹С… РїР°РєРµС‚РѕРІ Linux РјРѕР¶РµС‚ Р±С‹С‚СЊ РґРѕРїРѕР»РЅРёС‚РµР»СЊРЅС‹Р№ РєР°С‚Р°Р»РѕРі Р°СЂС…РёС‚РµРєС‚СѓСЂС‹:
    # /usr/lib/<arch>/cmake/Qt5Core. РџСЂРѕРІРµСЂСЏРµРј РЅРµСЃРєРѕР»СЊРєРѕ СѓСЂРѕРІРЅРµР№.
    if(DEFINED GEOSCHEME_QDOC_QT_ROOT AND GEOSCHEME_QDOC_QT_ROOT)
        get_filename_component(_gs_qt_root
            "${GEOSCHEME_QDOC_QT_ROOT}" ABSOLUTE)
    else()
        set(_gs_qt_root "")
    endif()

    foreach(_gs_root_depth 3 4 2)
        if(_gs_qt_root)
            break()
        endif()
        # Р”Р»СЏ Qt Online Installer РѕР±С‹С‡РЅРѕ РґРѕСЃС‚Р°С‚РѕС‡РЅРѕ С‚СЂС‘С… СѓСЂРѕРІРЅРµР№;
        # Сѓ СЃРёСЃС‚РµРјРЅС‹С… Linux-РїР°РєРµС‚РѕРІ РјРѕР¶РµС‚ РїРѕС‚СЂРµР±РѕРІР°С‚СЊСЃСЏ С‡РµС‚С‹СЂРµ.
        if(_gs_root_depth EQUAL 3)
            get_filename_component(_gs_qt_root_candidate "${Qt5Core_DIR}/../../.." ABSOLUTE)
        elseif(_gs_root_depth EQUAL 4)
            get_filename_component(_gs_qt_root_candidate "${Qt5Core_DIR}/../../../.." ABSOLUTE)
        else()
            get_filename_component(_gs_qt_root_candidate "${Qt5Core_DIR}/../.." ABSOLUTE)
        endif()

        if(IS_DIRECTORY "${_gs_qt_root_candidate}/include"
           OR IS_DIRECTORY "${_gs_qt_root_candidate}/bin")
            set(_gs_qt_root "${_gs_qt_root_candidate}")
            break()
        endif()
    endforeach()

    if(NOT _gs_qt_root)
        message(FATAL_ERROR
            "[Docs] Cannot determine Qt installation root from Qt5Core_DIR=${Qt5Core_DIR}. "
            "Set GEOSCHEME_QDOC_QT_ROOT explicitly.")
    endif()

    set(_gs_qt_bin "${_gs_qt_root}/bin")
    set(_gs_qt_headers "${_gs_qt_root}/include")

    if(NOT IS_DIRECTORY "${_gs_qt_headers}" AND Qt5Core_INCLUDE_DIRS)
        list(GET Qt5Core_INCLUDE_DIRS 0 _gs_qt_headers_candidate)
        if(_gs_qt_headers_candidate MATCHES "[/\\\\]QtCore$")
            get_filename_component(_gs_qt_headers
                "${_gs_qt_headers_candidate}/.." ABSOLUTE)
        else()
            set(_gs_qt_headers "${_gs_qt_headers_candidate}")
        endif()
    endif()

    if(DEFINED Qt5Core_VERSION AND NOT "${Qt5Core_VERSION}" STREQUAL "")
        set(_gs_qt_version "${Qt5Core_VERSION}")
    elseif(DEFINED Qt5Core_VERSION_STRING)
        set(_gs_qt_version "${Qt5Core_VERSION_STRING}")
    else()
        set(_gs_qt_version "${Qt5_VERSION}")
    endif()

    # Р’ СѓСЃС‚Р°РЅРѕРІРєРµ Qt Online Installer РґРѕРєСѓРјРµРЅС‚Р°С†РёСЏ РѕР±С‹С‡РЅРѕ СЂР°СЃРїРѕР»РѕР¶РµРЅР°
    # СЂСЏРґРѕРј СЃ РєР°С‚Р°Р»РѕРіРѕРј РІРµСЂСЃРёРё Рё РєР°С‚Р°Р»РѕРіРѕРј РєРѕРЅРєСЂРµС‚РЅРѕРіРѕ compiler kit.
    get_filename_component(_gs_qt_version_root "${_gs_qt_root}" DIRECTORY)
    get_filename_component(_gs_qt_sdk_root "${_gs_qt_version_root}" DIRECTORY)

    if(NOT DEFINED GEOSCHEME_QDOC_QT_DOCS)
        set(_gs_qt_docs_candidates
            "${_gs_qt_sdk_root}/Docs/Qt-${_gs_qt_version}"
            "${_gs_qt_root}/Docs/Qt-${_gs_qt_version}"
            "${_gs_qt_root}/share/qt5/doc"
            "${_gs_qt_root}/share/doc/qt${_gs_qt_version}"
            "${_gs_qt_root}/share/doc/qt5"
        )
        set(_gs_qt_docs_candidate "")
        foreach(_gs_candidate IN LISTS _gs_qt_docs_candidates)
            if(IS_DIRECTORY "${_gs_candidate}")
                set(_gs_qt_docs_candidate "${_gs_candidate}")
                break()
            endif()
        endforeach()
        if(NOT _gs_qt_docs_candidate)
            list(GET _gs_qt_docs_candidates 0 _gs_qt_docs_candidate)
        endif()
        set(GEOSCHEME_QDOC_QT_DOCS "${_gs_qt_docs_candidate}"
            CACHE PATH "Qt documentation directory used by QDoc")
    endif()
    set(_gs_qt_docs "${GEOSCHEME_QDOC_QT_DOCS}")

    # РћРїСЂРµРґРµР»СЏРµРј РєР°С‚Р°Р»РѕРі РєРѕРјРїРёР»СЏС‚РѕСЂР° РёР· С„Р°РєС‚РёС‡РµСЃРєРё РІС‹Р±СЂР°РЅРЅРѕРіРѕ CMake-РєРѕРјРїРёР»СЏС‚РѕСЂР°.
    # РќРёРєР°РєРёРµ РёРјРµРЅР° РІСЂРѕРґРµ mingw730_64 РёР»Рё РІРµСЂСЃРёРё GCC РЅРµ Р·Р°С€РёРІР°СЋС‚СЃСЏ РІ РјРѕРґСѓР»СЊ.
    set(_gs_mingw_root "")
    set(_gs_mingw_bin "")
    set(_gs_mingw_cxx "")
    set(_gs_mingw_cxx_arch "")
    set(_gs_mingw_cxx_back "")
    set(_gs_mingw_inc "")
    set(_gs_mingw_sys "")

    if(MINGW AND CMAKE_CXX_COMPILER)
        get_filename_component(_gs_compiler_bin
            "${CMAKE_CXX_COMPILER}" DIRECTORY)
        get_filename_component(_gs_mingw_root
            "${_gs_compiler_bin}/.." ABSOLUTE)
        set(_gs_mingw_bin "${_gs_compiler_bin}")

        file(GLOB _gs_gcc_version_dirs
            LIST_DIRECTORIES TRUE
            "${_gs_mingw_root}/lib/gcc/*/*")

        set(_gs_gcc_dir "")
        foreach(_gs_candidate IN LISTS _gs_gcc_version_dirs)
            get_filename_component(_gs_candidate_version
                "${_gs_candidate}" NAME)
            if(DEFINED CMAKE_CXX_COMPILER_VERSION
               AND "${_gs_candidate_version}" STREQUAL "${CMAKE_CXX_COMPILER_VERSION}")
                set(_gs_gcc_dir "${_gs_candidate}")
                break()
            endif()
        endforeach()

        # Р•СЃР»Рё РІРµСЂСЃРёСЏ РєРѕРјРїРёР»СЏС‚РѕСЂР° РЅРµ СЃРѕРІРїР°Р»Р° СЃ РёРјРµРЅРµРј РєР°С‚Р°Р»РѕРіР°, РІС‹Р±РёСЂР°РµРј
        # РµРґРёРЅСЃС‚РІРµРЅРЅС‹Р№/РїРµСЂРІС‹Р№ РЅР°Р№РґРµРЅРЅС‹Р№ РєР°С‚Р°Р»РѕРі GCC.
        if(NOT _gs_gcc_dir AND _gs_gcc_version_dirs)
            list(GET _gs_gcc_version_dirs 0 _gs_gcc_dir)
        endif()

        if(_gs_gcc_dir)
            get_filename_component(_gs_gcc_target "${_gs_gcc_dir}" DIRECTORY)
            get_filename_component(_gs_gcc_target "${_gs_gcc_target}" NAME)

            set(_gs_mingw_cxx "${_gs_gcc_dir}/include/c++")
            set(_gs_mingw_cxx_arch "${_gs_mingw_cxx}/${_gs_gcc_target}")
            set(_gs_mingw_cxx_back "${_gs_mingw_cxx}/backward")
            set(_gs_mingw_inc "${_gs_gcc_dir}/include")
            set(_gs_mingw_sys
                "${_gs_mingw_root}/${_gs_gcc_target}/include")
        endif()
    endif()

    if(NOT IS_DIRECTORY "${_gs_qt_headers}")
        message(WARNING
            "[Docs] Qt headers directory was not found: ${_gs_qt_headers}")
    endif()

    if(NOT IS_DIRECTORY "${_gs_qt_docs}")
        message(WARNING
            "[Docs] Qt documentation was not found: ${_gs_qt_docs}")
        message(WARNING
            "[Docs] Install the Qt Documentation component or set GEOSCHEME_QDOC_QT_DOCS.")
    else()
        foreach(_gs_conf compat macros qt-cpp-defines fileextensions)
            if(NOT EXISTS "${_gs_qt_docs}/global/${_gs_conf}.qdocconf")
                message(WARNING
                    "[Docs] Qt QDoc configuration is missing: ${_gs_qt_docs}/global/${_gs_conf}.qdocconf")
            endif()
        endforeach()
    endif()

    message(STATUS "[Docs] Qt root            = ${_gs_qt_root}")
    message(STATUS "[Docs] Qt version         = ${_gs_qt_version}")
    message(STATUS "[Docs] Qt headers         = ${_gs_qt_headers}")
    message(STATUS "[Docs] Qt documentation   = ${_gs_qt_docs}")

    if(_gs_mingw_root)
        message(STATUS "[Docs] MinGW root         = ${_gs_mingw_root}")
        message(STATUS "[Docs] MinGW C++ headers  = ${_gs_mingw_cxx}")
    endif()
endmacro()

