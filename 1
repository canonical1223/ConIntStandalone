Да. Ниже полный переработанный вариант GeoSchemeDocs.cmake. Я сохранил основу твоего старого кода, в том числе поиск QDoc, Qt/MinGW, рекурсивный сбор include-путей и переменные AUTOGEN.
Основные изменения:
	•	Убрал проверку наличия HTML-каталога как признак готовой документации. Теперь используется stamp-файл.
	•	Исправил порядок команд: каталог создаётся до запуска QDoc, stamp — только после успешной генерации.
	•	Добавил динамическое получение AUTOGEN-путей без жёстко заданных каталогов.
	•	Сохранил отдельные цели документации для каждого модуля.
	•		•	Добавил POST_BUILD, чтобы обычная сборка модуля запускала генерацию его документации.
	•	Сохранил полную пересборку документации проекта.
Важное ограничение: POST_BUILD выполняется для каждого модуля, который действительно собирается. Поэтому если при сборке одного модуля одновременно пересобираются его зависимости, их POST_BUILD тоже могут запустить QDoc. Стандартный граф зависимостей CMake не позволяет надёжно определить, какой target пользователь указал непосредственно в --target, а какой собирается как зависимость.
Полный GeoSchemeDocs.cmake
# =============================================================================
# GeoSchemeDocs.cmake
#
# Система генерации документации GeoScheme через QDoc.
#
# Возможности:
#   - автоматический поиск QDoc;
#   - определение окружения Qt и MinGW;
#   - автоматический сбор include-путей;
#   - поддержка AUTOGEN / AUTOUIC;
#   - генерация документации отдельного модуля;
#   - генерация документации после сборки модуля;
#   - принудительная пересборка документации модуля;
#   - генерация общего индекса GeoScheme;
#   - полная пересборка документации.
#
# Требования:
#   - CMake 3.14+
#   - Qt 5
#
# =============================================================================

# -----------------------------------------------------------------------------
# Поиск QDoc
# -----------------------------------------------------------------------------

macro(_gs_find_qdoc)

    if (NOT QDOC_EXECUTABLE)

        find_package(Qt5 REQUIRED COMPONENTS Core)

        # Qt5Core_DIR:
        # <QtRoot>/lib/cmake/Qt5Core
        #
        # Получаем корень установленного Qt без LOCATION target property.

        get_filename_component(
            _gs_qt_cmake_dir
            "${Qt5Core_DIR}"
            DIRECTORY
        )

        get_filename_component(
            _gs_qt_cmake_parent
            "${_gs_qt_cmake_dir}"
            DIRECTORY
        )

        get_filename_component(
            _gs_qt_lib_dir
            "${_gs_qt_cmake_parent}"
            DIRECTORY
        )

        get_filename_component(
            _gs_qt_root
            "${_gs_qt_lib_dir}"
            DIRECTORY
        )

        if (WIN32)
            set(_gs_qdoc_name qdoc.exe)
        else()
            set(_gs_qdoc_name qdoc)
        endif()

        set(
            QDOC_EXECUTABLE
            "${_gs_qt_root}/bin/${_gs_qdoc_name}"
            CACHE FILEPATH "Path to qdoc executable"
            FORCE
        )

        if (NOT EXISTS "${QDOC_EXECUTABLE}")
            message(FATAL_ERROR
                "[Docs] qdoc not found: ${QDOC_EXECUTABLE}"
            )
        endif()

        message(STATUS
            "[Docs] qdoc found: ${QDOC_EXECUTABLE}"
        )

    endif()

endmacro()

# -----------------------------------------------------------------------------
# Определение окружения Qt и MinGW
# -----------------------------------------------------------------------------

macro(_gs_compute_qt_env)

    find_package(Qt5 REQUIRED COMPONENTS Core)

    get_filename_component(
        _gs_qt_cmake
        "${Qt5Core_DIR}"
        DIRECTORY
    )

    get_filename_component(
        _gs_qt_lib
        "${_gs_qt_cmake}"
        DIRECTORY
    )

    get_filename_component(
        _gs_qt_root
        "${_gs_qt_lib}"
        DIRECTORY
    )

    get_filename_component(
        _gs_qt_ver_root
        "${_gs_qt_root}/.."
        ABSOLUTE
    )

    get_filename_component(
        _gs_qt_sdk_root
        "${_gs_qt_ver_root}/.."
        ABSOLUTE
    )

    set(_gs_qt_prefix  "${_gs_qt_root}")
    set(_gs_qt_headers "${_gs_qt_root}/include")
    set(_gs_qt_version "${Qt5Core_VERSION}")

    set(
        _gs_qt_docs
        "${_gs_qt_sdk_root}/Docs/Qt-${_gs_qt_version}"
    )

    # MinGW из структуры установленного Qt.

    set(
        _gs_mingw_root
        "${_gs_qt_sdk_root}/Tools/mingw730_64"
    )

    # Если стандартный каталог отсутствует,
    # пробуем определить MinGW через gcc.

    if (NOT EXISTS "${_gs_mingw_root}")

        message(WARNING
            "[Docs] MinGW not found: ${_gs_mingw_root}"
        )

        find_program(
            _gs_gcc_exe
            NAMES gcc g++ mingw32-g++
        )

        if (_gs_gcc_exe)

            get_filename_component(
                _gs_gcc_bin
                "${_gs_gcc_exe}"
                DIRECTORY
            )

            get_filename_component(
                _gs_mingw_root
                "${_gs_gcc_bin}/.."
                ABSOLUTE
            )

            message(STATUS
                "[Docs] MinGW found via gcc: ${_gs_mingw_root}"
            )

        else()

            message(WARNING
                "[Docs] MinGW not found - C++ headers unavailable"
            )

        endif()

    endif()

    # Пути стандартных заголовков MinGW.
    #
    # Для Qt 5.14.2 / MinGW 7.3.0.

    set(
        _gs_mingw_cxx
        "${_gs_mingw_root}/lib/gcc/x86_64-w64-mingw32/7.3.0/include/c++"
    )

    set(
        _gs_mingw_cxx_arch
        "${_gs_mingw_cxx}/x86_64-w64-mingw32"
    )

    set(
        _gs_mingw_cxx_back
        "${_gs_mingw_cxx}/backward"
    )

    set(
        _gs_mingw_inc
        "${_gs_mingw_root}/lib/gcc/x86_64-w64-mingw32/7.3.0/include"
    )

    set(
        _gs_mingw_sys
        "${_gs_mingw_root}/x86_64-w64-mingw32/include"
    )

    # Проверка документации Qt.

    if (NOT EXISTS "${_gs_qt_docs}")

        message(WARNING
            "[Docs] Qt docs not found: ${_gs_qt_docs}"
        )

        message(WARNING
            "[Docs] Install Qt Documentation via Qt Maintenance Tool."
        )

    else()

        foreach(_gs_conf
                compat
                macros
                qt-cpp-defines
                fileextensions)

            if (NOT EXISTS
                    "${_gs_qt_docs}/global/${_gs_conf}.qdocconf")

                message(WARNING
                    "[Docs] Missing: ${_gs_qt_docs}/global/${_gs_conf}.qdocconf"
                )

            endif()

        endforeach()

    endif()

    message(STATUS "[Docs] Qt root            = ${_gs_qt_root}")
    message(STATUS "[Docs] QT_INSTALL_PREFIX  = ${_gs_qt_prefix}")
    message(STATUS "[Docs] QT_INSTALL_HEADERS = ${_gs_qt_headers}")
    message(STATUS "[Docs] QT_INSTALL_DOCS    = ${_gs_qt_docs}")
    message(STATUS "[Docs] MinGW root         = ${_gs_mingw_root}")
    message(STATUS "[Docs] MinGW C++          = ${_gs_mingw_cxx}")

endmacro()

# -----------------------------------------------------------------------------
# Безопасный PATH для QDoc
# -----------------------------------------------------------------------------

macro(_gs_compute_safe_path)

    if (NOT DEFINED _gs_qt_root OR NOT DEFINED _gs_mingw_root)

        message(FATAL_ERROR
            "[Docs] _gs_compute_safe_path called before _gs_compute_qt_env"
        )

    endif()

    if (DEFINED ENV{PATH})

        set(_gs_orig_path "$ENV{PATH}")

        # Удаляем старые версии Qt 5.12.

        string(
            REGEX REPLACE
            "[^;]*Qt5\\.12\\.[^;]*;?"
            ""
            _gs_safe_path
            "${_gs_orig_path}"
        )

        # Удаляем дублирующий путь MinGW.

        string(
            REGEX REPLACE
            "[^;]*Tools[\\/]mingw730_64[\\/]bin;?"
            ""
            _gs_safe_path
            "${_gs_safe_path}"
        )

        set(
            _gs_safe_path
            "${_gs_qt_root}/bin;${_gs_mingw_root}/bin;${_gs_safe_path}"
        )

        message(STATUS
            "[Docs] Safe PATH = ${_gs_safe_path}"
        )

    else()

        set(_gs_safe_path "")

    endif()

endmacro()

# -----------------------------------------------------------------------------
# Получение AUTOGEN include-пути конкретного target
#
# Используются:
#   AUTOGEN_BUILD_DIR;
#   стандартный каталог <Target>_autogen;
#   include.
#
# Никаких жёстко заданных путей.
# -----------------------------------------------------------------------------

function(_gs_get_target_autogen_include TARGET_NAME OUT_VAR)

    set(_result "")

    if (NOT TARGET "${TARGET_NAME}")
        set(${OUT_VAR} "" PARENT_SCOPE)
        return()
    endif()

    get_target_property(
        _autogen_dir
        "${TARGET_NAME}"
        AUTOGEN_BUILD_DIR
    )

    if (NOT _autogen_dir OR _autogen_dir MATCHES "-NOTFOUND$")

        get_target_property(
            _binary_dir
            "${TARGET_NAME}"
            BINARY_DIR
        )

        if (_binary_dir)

            set(
                _autogen_dir
                "${_binary_dir}/${TARGET_NAME}_autogen"
            )

        endif()

    endif()

    if (_autogen_dir)

        set(_include_dir "${_autogen_dir}/include")

        if (IS_DIRECTORY "${_include_dir}")
            list(APPEND _result "${_include_dir}")
        endif()

        # Дополнительные конфигурационные каталоги,
        # если они уже созданы CMake.

        file(
            GLOB _config_include_dirs
            LIST_DIRECTORIES TRUE
            "${_autogen_dir}/include_*"
        )

        foreach(_dir ${_config_include_dirs})

            if (IS_DIRECTORY "${_dir}")
                list(APPEND _result "${_dir}")
            endif()

        endforeach()

    endif()

    set(${OUT_VAR} "${_result}" PARENT_SCOPE)

endfunction()

# -----------------------------------------------------------------------------
# Рекурсивный сбор include-путей target и его зависимостей
#
# Собираются:
#   INCLUDE_DIRECTORIES
#   INTERFACE_INCLUDE_DIRECTORIES
#   LINK_LIBRARIES
#   INTERFACE_LINK_LIBRARIES
#   AUTOGEN include
#
# Защита от циклических зависимостей.
# -----------------------------------------------------------------------------

function(_gs_collect_includes TARGET_NAME OUT_INCLUDES OUT_TARGETS VISITED)

    if ("${TARGET_NAME}" IN_LIST VISITED)
        return()
    endif()

    if (NOT TARGET "${TARGET_NAME}")
        return()
    endif()

    list(APPEND VISITED "${TARGET_NAME}")

    set(_local_includes "")

    # INCLUDE_DIRECTORIES.

    get_target_property(
        _dirs
        "${TARGET_NAME}"
        INCLUDE_DIRECTORIES
    )

    if (_dirs AND NOT _dirs MATCHES "-NOTFOUND$")

        foreach(_dir ${_dirs})

            if (_dir MATCHES "\\$<BUILD_INTERFACE:(.+)>")

                list(APPEND _local_includes "${CMAKE_MATCH_1}")

            elseif (NOT _dir MATCHES "\\$<")

                list(APPEND _local_includes "${_dir}")

            endif()

        endforeach()

    endif()

    # INTERFACE_INCLUDE_DIRECTORIES.

    get_target_property(
        _idirs
        "${TARGET_NAME}"
        INTERFACE_INCLUDE_DIRECTORIES
    )

    if (_idirs AND NOT _idirs MATCHES "-NOTFOUND$")

        foreach(_dir ${_idirs})

            if (_dir MATCHES "\\$<BUILD_INTERFACE:(.+)>")

                list(APPEND _local_includes "${CMAKE_MATCH_1}")

            elseif (NOT _dir MATCHES "\\$<")

                list(APPEND _local_includes "${_dir}")

            endif()

        endforeach()

    endif()

    # AUTOGEN.

    _gs_get_target_autogen_include(
        "${TARGET_NAME}"
        _autogen_includes
    )

    list(APPEND _local_includes ${_autogen_includes})

    # LINK_LIBRARIES.

    get_target_property(
        _libs
        "${TARGET_NAME}"
        LINK_LIBRARIES
    )

    if (_libs AND NOT _libs MATCHES "-NOTFOUND$")

        foreach(_lib ${_libs})

            if (_lib MATCHES "\\$<")
                continue()
            endif()

            if (NOT TARGET "${_lib}")
                continue()
            endif()

            if ("${_lib}" IN_LIST VISITED)
                continue()
            endif()

            set(_sub_includes "")
            set(_sub_visited "${VISITED}")

            _gs_collect_includes(
                "${_lib}"
                _sub_includes
                _sub_visited
                "${_sub_visited}"
            )

            list(APPEND _local_includes ${_sub_includes})
            set(VISITED "${_sub_visited}")

        endforeach()

    endif()

    # INTERFACE_LINK_LIBRARIES.

    get_target_property(
        _ilibs
        "${TARGET_NAME}"
        INTERFACE_LINK_LIBRARIES
    )

    if (_ilibs AND NOT _ilibs MATCHES "-NOTFOUND$")

        foreach(_lib ${_ilibs})

            if (_lib MATCHES "\\$<")
                continue()
            endif()

            if (NOT TARGET "${_lib}")
                continue()
            endif()

            if ("${_lib}" IN_LIST VISITED)
                continue()
            endif()

            set(_sub_includes "")
            set(_sub_visited "${VISITED}")

            _gs_collect_includes(
                "${_lib}"
                _sub_includes
                _sub_visited
                "${_sub_visited}"
            )

            list(APPEND _local_includes ${_sub_includes})
            set(VISITED "${_sub_visited}")

        endforeach()

    endif()

    list(REMOVE_DUPLICATES _local_includes)

    set(${OUT_INCLUDES} "${_local_includes}" PARENT_SCOPE)
    set(${OUT_TARGETS} "${VISITED}" PARENT_SCOPE)

endfunction()

# -----------------------------------------------------------------------------
# Формирование аргументов -I для QDoc
# -----------------------------------------------------------------------------

function(_gs_build_include_path_args MODULE_NAME QT_HEADERS MINGW_PATHS OUT_ARGS)

    set(_args "")

    # 1. Заголовки MinGW.

    foreach(_path ${MINGW_PATHS})

        if (IS_DIRECTORY "${_path}")
            list(APPEND _args "-I${_path}")
        endif()

    endforeach()

    # 2. Заголовки Qt.

    foreach(_sub
            ""
            "QtCore"
            "QtGui"
            "QtWidgets"
            "QtXml"
            "QtSql"
            "QtNetwork"
            "QtSvg"
            "QtPrintSupport"
            "QtConcurrent")

        if (_sub STREQUAL "")

            set(_qt_path "${QT_HEADERS}")

        else()

            set(_qt_path "${QT_HEADERS}/${_sub}")

        endif()

        if (IS_DIRECTORY "${_qt_path}")
            list(APPEND _args "-I${_qt_path}")
        endif()

    endforeach()

    # 3. Заголовки модуля и его зависимостей.

    if (TARGET "${MODULE_NAME}")

        set(_visited "")
        set(_module_includes "")

        _gs_collect_includes(
            "${MODULE_NAME}"
            _module_includes
            _visited
            "${_visited}"
        )

        list(REMOVE_DUPLICATES _module_includes)

        set(_count 0)

        foreach(_inc ${_module_includes})

            if (IS_DIRECTORY "${_inc}")

                list(APPEND _args "-I${_inc}")

                math(EXPR _count "${_count} + 1")

                message(STATUS
                    "[Docs] ${MODULE_NAME}: -I${_inc}"
                )

            endif()

        endforeach()

        message(STATUS
            "[Docs] ${MODULE_NAME}: added ${_count} project include paths"
        )

    else()

        message(WARNING
            "[Docs] ${MODULE_NAME}: target not found, include paths not collected"
        )

    endif()

    list(REMOVE_DUPLICATES _args)

    set(${OUT_ARGS} "${_args}" PARENT_SCOPE)

endfunction()

# -----------------------------------------------------------------------------
# Получение специальных AUTOGEN-путей для .qdocconf
#
# Сохраняем совместимость с переменными:
#   GEOPROIMPORT_AUTOGEN_INCLUDE
#   GEOSCHEMEIMPEXP_AUTOGEN_INCLUDE
#
# Пути вычисляются по свойствам реальных target.
# -----------------------------------------------------------------------------

function(_gs_get_special_autogen_env OUT_ENV)

    set(_env "")

    if (TARGET GeoProImportDao)

        _gs_get_target_autogen_include(
            GeoProImportDao
            _geoproimport_include
        )

        if (_geoproimport_include)

            list(GET _geoproimport_include 0 _geoproimport_path)

            list(APPEND _env
                "GEOPROIMPORT_AUTOGEN_INCLUDE=${_geoproimport_path}"
            )

        endif()

    endif()

    if (TARGET GeoSchemeImpExp)

        _gs_get_target_autogen_include(
            GeoSchemeImpExp
            _geoschemeimpexp_include
        )

        if (_geoschemeimpexp_include)

            list(GET _geoschemeimpexp_include 0 _geoschemeimpexp_path)

            list(APPEND _env
                "GEOSCHEMEIMPEXP_AUTOGEN_INCLUDE=${_geoschemeimpexp_path}"
            )

        endif()

    endif()

    set(${OUT_ENV} "${_env}" PARENT_SCOPE)

endfunction()

# -----------------------------------------------------------------------------
# Формирование общего окружения QDoc
# -----------------------------------------------------------------------------

function(_gs_get_qdoc_environment OUT_ENV)

    set(_env
        "QT_INSTALL_DOCS=${_gs_qt_docs}"
        "QT_INSTALL_HEADERS=${_gs_qt_headers}"
        "QT_INSTALL_PREFIX=${_gs_qt_prefix}"
        "QT_VERSION=${_gs_qt_version}"
        "QT_VER=${_gs_qt_version}"
        "MINGW_CXX=${_gs_mingw_cxx}"
        "MINGW_CXX_ARCH=${_gs_mingw_cxx_arch}"
        "MINGW_CXX_BACK=${_gs_mingw_cxx_back}"
        "MINGW_INC=${_gs_mingw_inc}"
        "MINGW_SYS=${_gs_mingw_sys}"
        "INCLUDE="
        "CPLUS_INCLUDE_PATH="
        "C_INCLUDE_PATH="
        "PATH=${_gs_safe_path}"
        "QDOC_DISABLE_CLANG=1"
    )

    _gs_get_special_autogen_env(_special_env)

    list(APPEND _env ${_special_env})

    set(${OUT_ENV} "${_env}" PARENT_SCOPE)

endfunction()

# -----------------------------------------------------------------------------
# Логирование аргументов QDoc
# -----------------------------------------------------------------------------

function(_gs_write_qdoc_args_log MODULE_NAME LOG_DIR ARGS)

    file(MAKE_DIRECTORY "${LOG_DIR}")

    string(
        REPLACE ";"
        "\n"
        _args_pretty
        "${ARGS}"
    )

    file(WRITE
        "${LOG_DIR}/${MODULE_NAME}_qdoc_args.txt"

        "# Аргументы -I для ${MODULE_NAME}\n"
        "# Сформировано при конфигурации CMake.\n\n"
        "${_args_pretty}\n"
    )

    message(STATUS
        "[Docs] ${MODULE_NAME}: qdoc args log = ${LOG_DIR}/${MODULE_NAME}_qdoc_args.txt"
    )

endfunction()

# -----------------------------------------------------------------------------
# gs_add_doc_target(MODULE_NAME QDOCCONF_FILENAME)
#
# Регистрирует генерацию документации одного модуля.
#
# Режимы:
#
#   1. Обычная сборка MODULE_NAME:
#      POST_BUILD запускает QDoc после сборки target.
#
#   2. docs_MODULE_NAME:
#      Отдельная цель документации.
#
#   3. docs_MODULE_NAME_rebuild:
#      Принудительная пересборка документации.
#
# -----------------------------------------------------------------------------

function(gs_add_doc_target MODULE_NAME QDOCCONF_FILENAME)

    if (NOT GEOSCHEME_BUILD_DOCS)
        return()
    endif()

    if (NOT TARGET "${MODULE_NAME}")

        message(WARNING
            "[Docs] ${MODULE_NAME}: target does not exist"
        )

        return()

    endif()

    _gs_find_qdoc()
    _gs_compute_qt_env()
    _gs_compute_safe_path()

    get_filename_component(
        _gs_project_root
        "${CMAKE_SOURCE_DIR}"
        DIRECTORY
    )

    set(
        _gs_html_root
        "${_gs_project_root}/doc/qdoc/html"
    )

    set(
        _gs_mod_conf
        "${CMAKE_CURRENT_SOURCE_DIR}/${QDOCCONF_FILENAME}"
    )

    set(
        _gs_out_dir
        "${_gs_html_root}/${MODULE_NAME}"
    )

    set(
        _gs_stamp
        "${_gs_out_dir}/.cmake_docs_stamp"
    )

    message(STATUS "[Docs] ----------------------------------------")
    messa