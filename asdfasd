class HelpBrowser : public QTextBrowser {
    Q_OBJECT
public:
    HelpBrowser(QHelpEngine* engine, QWidget* parent = nullptr)
        : QTextBrowser(parent), m_engine(engine) {}

protected:
    QVariant loadResource(int type, const QUrl& name) override {
        if (name.scheme() == QLatin1String("qthelp"))
            return m_engine->fileData(name);
        return QTextBrowser::loadResource(type, name);
    }
private:
    QHelpEngine* m_engine;
};

class HelpManager : public QObject
{
    Q_OBJECT
public:
    static HelpManager& instance();

    // Ищет help.qch (bin/help рядом с exe, затем путь сборки), читает карту
    // из qrc продукта и запускает справочный движок.
    bool startDefault(const QString& mapResource);

    QString helpNamespace() const { return m_namespace; }

    void setUseEmbeddedViewer(bool on) { m_useEmbeddedViewer = on; }
    void setAllowExternalUrls(bool on) { m_allowExternalUrls = on; }

    void openHelp(const QString& urlSource);
    void openHelpForKey(const QString& key);
    void showHelpForObject(QObject* obj);
    void dumpMappings() const;

protected:
    bool eventFilter(QObject* obj, QEvent* event) override;

private:
    explicit HelpManager(QObject* parent = nullptr);
    void initialize();
    void loadSitemap();
    void printHierarchy(QObject* obj) const;
    QAction* actionAt(QWidget* widget, const QPoint& globalPos);

    QString m_qchPath;
    QString m_namespace;
    QString m_mapResource;
    QMap<QString, QString> m_helpMap;
    bool m_useEmbeddedViewer = true;
    bool m_allowExternalUrls = false;
    bool m_started = false;

    QHelpEngine* m_helpEngine = nullptr;
    QPointer<HelpWindow> m_helpWindow;
};

#endif // HELPMANAGER_H

