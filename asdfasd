#include <QLabel>
#include <QHelpSearchEngine>
#include <QHelpSearchQueryWidget>
#include <QHelpSearchResultWidget>
#include <QHelpContentModel>
#include <QHelpContentWidget>

HelpWindow::HelpWindow(QHelpEngine* engine, QWidget* parent)
    : QDialog(parent), ui(new Ui::HelpWindow), m_helpEngine(engine)
{
    ui->setupUi(this);
    setWindowFlags(Qt::Window | Qt::WindowMinimizeButtonHint |
                   Qt::WindowMaximizeButtonHint | Qt::WindowCloseButtonHint);

    const QString ns = HelpManager::instance().helpNamespace();

    m_currentBrowser = new HelpBrowser(m_helpEngine, this);
    m_currentBrowser->setSearchPaths({QString("qthelp://%1/doc/").arg(ns)});
    m_currentBrowser->setOpenLinks(false);
    ui->browserLayout->addWidget(m_currentBrowser);

    if (!ui->tabContent->layout()) ui->tabContent->setLayout(new QVBoxLayout());
    ui->tabContent->layout()->setContentsMargins(0, 0, 0, 0);
    ui->tabContent->layout()->addWidget(m_helpEngine->contentWidget());

    auto* searchEngine = m_helpEngine->searchEngine();
    ui->searchLayout->addWidget(searchEngine->queryWidget());
    ui->searchLayout->addWidget(searchEngine->resultWidget());

    connect(ui->actBack,    &QAction::triggered, m_currentBrowser, &HelpBrowser::backward);
    connect(ui->actForward, &QAction::triggered, m_currentBrowser, &HelpBrowser::forward);
    connect(ui->actHome,    &QAction::triggered, this, [this, ns]() {
        setSource(QUrl(QString("qthelp://%1/doc/index_print.html").arg(ns)));
    });

    connect(m_currentBrowser, &HelpBrowser::anchorClicked,
            this, &HelpWindow::handleAnchorClick);

    connect(ui->breadcrumbLabel, &QLabel::linkActivated, this, [this](const QString& link) {
        setSource(QUrl(link));
    });

    // везде this как контекст: связь рвётся при уничтожении окна,
    // виджеты движка переживают окно и иначе копили бы связи
    connect(m_currentBrowser, &HelpBrowser::sourceChanged, this, [this](const QUrl& u) {
        updateBreadcrumbs(u);
        QModelIndex idx = m_helpEngine->contentWidget()->indexOf(u);
        if (idx.isValid()) {
            m_helpEngine->contentWidget()->setCurrentIndex(idx);
            m_helpEngine->contentWidget()->scrollTo(idx);
        }
        ui->actBack->setEnabled(m_currentBrowser->isBackwardAvailable());
        ui->actForward->setEnabled(m_currentBrowser->isForwardAvailable());
    });

    connect(searchEngine->queryWidget(), &QHelpSearchQueryWidget::search,
            this, [searchEngine]() {
        searchEngine->search(searchEngine->queryWidget()->searchInput());
    });

    connect(searchEngine->resultWidget(), &QHelpSearchResultWidget::requestShowLink,
            this, &HelpWindow::setSource);

    connect(m_helpEngine->contentWidget(), &QHelpContentWidget::clicked,
            this, [this](const QModelIndex& index) {
        auto* model = qobject_cast<QHelpContentModel*>(m_helpEngine->contentWidget()->model());
        if (model) {
            auto* item = model->contentItemAt(index);
            if (item && item->url().isValid()) setSource(item->url());
        }
    });
}

HelpWindow::~HelpWindow()
{
    // виджеты принадлежат движку и должны пережить окно
    if (m_helpEngine) {
        if (auto* cw = m_helpEngine->contentWidget()) {
            cw->disconnect(this);
            cw->setParent(nullptr);
        }
        if (auto* se = m_helpEngine->searchEngine()) {
            se->disconnect(this);
            if (se->queryWidget()) {
                se->queryWidget()->disconnect(this);
                se->queryWidget()->setParent(nullptr);
            }
            if (se->resultWidget()) {
                se->resultWidget()->disconnect(this);
                se->resultWidget()->setParent(nullptr);
            }
        }
    }
    delete ui;
}

void HelpWindow::setSource(const QUrl& url)
{
    QUrl targetUrl = url;
    QString path = targetUrl.path();
    if (path.endsWith(".html") && !path.endsWith("_print.html")) {
        path = path.left(path.size() - 5) + "_print.html";
        targetUrl.setPath(path);
    }
    m_currentBrowser->setSource(targetUrl);
}

void HelpWindow::handleAnchorClick(const QUrl& u)
{
    if (u.scheme() == "qthelp") setSource(u);
    else QDesktopServices::openUrl(u);
}

void HelpWindow::updateBreadcrumbs(const QUrl& u)
{
    auto* model = qobject_cast<QHelpContentModel*>(m_helpEngine->contentWidget()->model());
    if (!model) return;

    QModelIndex idx = m_helpEngine->contentWidget()->indexOf(u);
    QStringList path;
    bool isCurrent = true;

    while (idx.isValid()) {
        if (auto* item = model->contentItemAt(idx)) {
            if (isCurrent) {
                path.prepend(QString("<b>%1</b>").arg(item->title()));
                isCurrent = false;
            } else {
                path.prepend(QString("<a href=\"%1\" style=\"text-decoration:none; color:#0055aa;\">%2</a>")
                                 .arg(item->url().toString(), item->title()));
            }
        }
        idx = idx.parent();
    }
    ui->breadcrumbLabel->setText(path.isEmpty()
        ? QString::fromUtf8("Справка")
        : path.join(" <span style='color:#999;'>▶</span> "));
}

