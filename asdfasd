HelpManager& HelpManager::instance()
{
    static HelpManager inst;
    return inst;
}

HelpManager::HelpManager(QObject* parent)
    : QObject(parent)
{
}

bool HelpManager::startDefault(const QString& mapResource)
{
    if (m_started) return true;

    QStringList candidates;
    candidates << QCoreApplication::applicationDirPath() + "/help/help.qch";
#ifdef HELP_QCH_DEV_PATH
    candidates << QString::fromUtf8(HELP_QCH_DEV_PATH);
#endif

    m_qchPath.clear();
    for (const QString& p : candidates) {
        if (QFile::exists(p)) { m_qchPath = p; break; }
    }
    if (m_qchPath.isEmpty()) {
        qWarning() << "HelpManager: help.qch not found. Searched:" << candidates;
        return false;
    }

    m_mapResource = mapResource;
    initialize();
    m_started = (m_helpEngine != nullptr);
    return m_started;
}

void HelpManager::initialize()
{
    static QTranslator qtTranslator;
    static QTranslator qtBaseTranslator;
    const QString trPath = QLibraryInfo::location(QLibraryInfo::TranslationsPath);

    if (qtTranslator.load(":/Translations/qt_help_ru.qm") ||
        qtTranslator.load("qt_help_ru.qm", trPath))
        qApp->installTranslator(&qtTranslator);
    if (qtBaseTranslator.load(":/Translations/qtbase_ru.qm") ||
        qtBaseTranslator.load("qtbase_ru.qm", trPath))
        qApp->installTranslator(&qtBaseTranslator);

    // namespace записан в самом qch (тег <namespace> в help.qhp)
    m_namespace = QHelpEngineCore::namespaceName(m_qchPath);
    if (m_namespace.isEmpty()) {
        qWarning() << "HelpManager: cannot read namespace from" << m_qchPath;
        return;
    }

    // .qhc - собственная база движка (регистрации и поисковый индекс).
    // qch никуда не копируется, регистрируется по месту.
    const QString dataDir = QStandardPaths::writableLocation(QStandardPaths::AppDataLocation)
                            + "/help";
    QDir().mkpath(dataDir);
    const QString qhcPath = dataDir + "/help_engine.qhc";

    m_helpEngine = new QHelpEngine(qhcPath, this);
    if (!m_helpEngine->setupData()) {
        // база повреждена - пересоздаём
        delete m_helpEngine;
        QFile::remove(qhcPath);
        m_helpEngine = new QHelpEngine(qhcPath, this);
        if (!m_helpEngine->setupData()) {
            qWarning() << "HelpManager: setupData failed:" << m_helpEngine->error();
            delete m_helpEngine;
            m_helpEngine = nullptr;
            return;
        }
    }

    // путь к qch мог измениться между сборками - перерегистрируем всё
    const QStringList registered = m_helpEngine->registeredDocumentations();
    for (const QString& ns : registered)
        m_helpEngine->unregisterDocumentation(ns);

    if (!m_helpEngine->registerDocumentation(m_qchPath)) {
        qWarning() << "HelpManager: registerDocumentation failed:"
                   << m_qchPath << m_helpEngine->error();
        return;
    }
    m_helpEngine->setupData();   // обновить дерево содержания

    m_helpEngine->searchEngine()->reindexDocumentation();

    qApp->installEventFilter(this);
    loadSitemap();
}

void HelpManager::loadSitemap()
{
    m_helpMap.clear();
    QFile file(m_mapResource);
    if (!file.open(QIODevice::ReadOnly)) {
        qWarning() << "HelpManager: help map not found in resources:" << m_mapResource;
        return;
    }
    const QJsonDocument doc = QJsonDocument::fromJson(file.readAll());
    if (doc.isNull()) return;

    const QJsonObject mapObj = doc.object().value("map").toObject();
    for (auto it = mapObj.begin(); it != mapObj.end(); ++it)
        m_helpMap.insert(it.key(), it.value().toString());
}

void HelpManager::openHelp(const QString& urlSource)
{
    if (!m_helpEngine) return;

    // отделяем якорь (#...) до подмены имени файла
    const QUrl src(urlSource, QUrl::TolerantMode);
    QString file = src.path();
    if (!file.endsWith("_print.html")) {
        if (file.endsWith(".html"))
            file = file.left(file.size() - 5) + "_print.html";
        else
            file += "_print.html";
    }

    QUrl url;
    url.setScheme("qthelp");
    url.setHost(m_namespace);
    url.setPath("/doc/" + file);
    if (src.hasFragment()) url.setFragment(src.fragment());

    if (m_helpWindow) {
        m_helpWindow->setSource(url);
        m_helpWindow->activateWindow();
        m_helpWindow->raise();
        return;
    }
    m_helpWindow = new HelpWindow(m_helpEngine);
    m_helpWindow->setAttribute(Qt::WA_DeleteOnClose);
    m_helpWindow->show();
    m_helpWindow->setSource(url);
}

void HelpManager::showHelpForObject(QObject* obj)
{
    if (!obj) return;

    QString page;
    QObject* current = obj;

    auto getObjId = [](QObject* o) -> QString {
        if (!o->objectName().isEmpty()) return o->objectName();
        return QString::fromLatin1(o->metaObject()->className());
    };

    while (current && page.isEmpty()) {
        const QVariant customKey = current->property("helpKey");
        if (customKey.isValid()) {
            const QString key = customKey.toString();
            if (m_helpMap.contains(key)) page = m_helpMap.value(key);
        }

        if (page.isEmpty()) {
            if (QAction* action = qobject_cast<QAction*>(current)) {
                const QString cleanText = action->text().remove('&').trimmed();
                if (!cleanText.isEmpty() && m_helpMap.contains(cleanText))
                    page = m_helpMap.value(cleanText);
            }
        }

        if (page.isEmpty() && current->isWidgetType()) {
            QWidget* w = qobject_cast<QWidget*>(current)->window();
            if (w && !w->windowTitle().isEmpty() && m_helpMap.contains(w->windowTitle()))
                page = m_helpMap.value(w->windowTitle());
        }

        if (page.isEmpty()) {
            QObject* parentObj = nullptr;
            if (QWidget* w = qobject_cast<QWidget*>(current)) parentObj = w->parentWidget();
            else parentObj = current->parent();

            if (parentObj) {
                const QString comboKey =
                    QString("%1/%2").arg(getObjId(parentObj), getObjId(current));
                if (m_helpMap.contains(comboKey)) page = m_helpMap.value(comboKey);
            }
        }

        if (page.isEmpty()) {
            const QString id = getObjId(current);
            if (m_helpMap.contains(id)) {
                page = m_helpMap.value(id);
            } else {
                const QMetaObject* meta = current->metaObject();
                while (meta) {
                    const QString className = QString::fromLatin1(meta->className());
                    if (m_helpMap.contains(className)) {
                        page = m_helpMap.value(className);
                        break;
                    }
                    meta = meta->superClass();
                }
            }
        }

        if (page.isEmpty()) {
            if (QWidget* w = qobject_cast<QWidget*>(current)) current = w->parentWidget();
            else current = current->parent();
        }
    }

    if (page.isEmpty()) page = "index_print.html";
    openHelp(page);
}

void HelpManager::printHierarchy(QObject* obj) const
{
    if (!obj) return;
    QStringList hierarchy;
    QObject* current = obj;
    while (current) {
        const QString name = current->objectName().isEmpty()
                                 ? QString("<no name>") : current->objectName();
        hierarchy.prepend(QString("%1[%2]")
                              .arg(QString::fromLatin1(current->metaObject()->className()), name));
        if (QWidget* w = qobject_cast<QWidget*>(current)) current = w->parentWidget();
        else current = current->parent();
    }
    qDebug().noquote() << "Help hierarchy:" << hierarchy.join(" > ");
}

bool HelpManager::eventFilter(QObject* obj, QEvent* event)
{
    if (event->type() == QEvent::KeyPress) {
        QKeyEvent* ke = static_cast<QKeyEvent*>(event);
        if (ke->key() == Qt::Key_F1) {
            QWidget* widgetAtMouse = QApplication::widgetAt(QCursor::pos());
            QObject* target = nullptr;
            if (widgetAtMouse) {
                QAction* action = actionAt(widgetAtMouse, QCursor::pos());
                target = action ? static_cast<QObject*>(action)
                                : static_cast<QObject*>(widgetAtMouse);
            } else {
                target = QApplication::focusWidget();
            }
            if (target) {
                printHierarchy(target);
                showHelpForObject(target);
                return true;
            }
        }
    }
    return QObject::eventFilter(obj, event);
}

QAction* HelpManager::actionAt(QWidget* widget, const QPoint& globalPos)
{
    if (!widget) return nullptr;
    const QPoint localPos = widget->mapFromGlobal(globalPos);
    if (QMenu* menu = qobject_cast<QMenu*>(widget))
        return menu->actionAt(localPos);
    if (QToolBar* toolbar = qobject_cast<QToolBar*>(widget)) {
        if (QAction* act = toolbar->actionAt(localPos)) return act;
        for (QAction* action : toolbar->actions())
            if (toolbar->actionGeometry(action).contains(localPos))
                return action;
    }
    if (QToolButton* btn = qobject_cast<QToolButton*>(widget))
        return btn->defaultAction();
    return nullptr;
}

void HelpManager::openHelpForKey(const QString& key)
{
    if (m_helpMap.contains(key)) openHelp(m_helpMap.value(key));
}

void HelpManager::dumpMappings() const
{
    for (auto it = m_helpMap.begin(); it != m_helpMap.end(); ++it)
        qDebug() << it.key() << "->" << it.value();
}

