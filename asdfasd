set(HELP_MANAGER_DIR "${CMAKE_CURRENT_LIST_DIR}")

# add_help_module(<target>
#     PRODUCT  GEO|SBO
#     QHP      <путь к help.qhp>
#     DOC_DIR  <папка, где лежат PDF продукта, туда копируется help.qch>
#     QRC      <qrc продукта с help_map.json и переводами>
#     INCLUDES <каталоги с заголовками интерфейса плагина>
#     LIBS     <библиотеки продукта>)
function(add_help_module TARGET)
    cmake_parse_arguments(H "" "PRODUCT;QHP;DOC_DIR;QRC" "INCLUDES;LIBS" ${ARGN})

    if(NOT H_PRODUCT OR NOT H_QHP OR NOT H_DOC_DIR)
        message(FATAL_ERROR "add_help_module: PRODUCT, QHP and DOC_DIR are required")
    endif()
    if(NOT EXISTS "${H_QHP}")
        message(FATAL_ERROR "add_help_module: help.qhp not found: ${H_QHP}")
    endif()

    find_package(Qt5 COMPONENTS Core Widgets Help REQUIRED)

    set(CMAKE_AUTOMOC ON)
    set(CMAKE_AUTOUIC ON)

    set(_core "${HELP_MANAGER_DIR}/core")
    if(H_PRODUCT STREQUAL "GEO")
        set(_plugin_dir "${HELP_MANAGER_DIR}/plugin_geo")
        set(_plugin_src "${_plugin_dir}/HelpModuleCreator.cpp")
    elseif(H_PRODUCT STREQUAL "SBO")
        set(_plugin_dir "${HELP_MANAGER_DIR}/plugin_sbo")
        set(_plugin_src "${_plugin_dir}/SboHelpCreator.cpp")
    else()
        message(FATAL_ERROR "add_help_module: unknown PRODUCT '${H_PRODUCT}'")
    endif()

    set(_qrc_srcs "")
    if(H_QRC)
        qt5_add_resources(_qrc_srcs "${H_QRC}")
    endif()

    add_library(${TARGET} SHARED
        ${_core}/HelpManager.h
        ${_core}/HelpManager.cpp
        ${_core}/HelpWindow.h
        ${_core}/HelpWindow.cpp
        ${_core}/HelpDialog.ui
        ${_plugin_src}
        ${_qrc_srcs})
    set_target_properties(${TARGET} PROPERTIES PREFIX "")

    target_include_directories(${TARGET} PRIVATE
        ${_core} ${_plugin_dir} ${H_INCLUDES})
    target_link_libraries(${TARGET} ${H_LIBS} Qt5::Core Qt5::Widgets Qt5::Help)
    target_compile_definitions(${TARGET} PRIVATE QT_PLUGIN)

    # ---- генерация help.qch тем же Qt, которым собирается продукт ----
    get_filename_component(_qt_bin "${Qt5Core_DIR}/../../../bin" ABSOLUTE)
    find_program(QHELPGENERATOR_EXE
        NAMES qhelpgenerator qhelpgenerator-qt5
        HINTS "${_qt_bin}")
    if(NOT QHELPGENERATOR_EXE)
        message(FATAL_ERROR "qhelpgenerator not found (looked in ${_qt_bin})")
    endif()

    get_filename_component(_qhp_dir "${H_QHP}" DIRECTORY)
    set(_gen "${_qhp_dir}/help.qch")                      # extra/html/Geo|Tec
    set(_doc "${H_DOC_DIR}/help.qch")                     # рядом с PDF (для install)
    set(_bin "${CMAKE_BINARY_DIR}/bin/help/help.qch")     # для запуска из IDE

    file(MAKE_DIRECTORY "${H_DOC_DIR}" "${CMAKE_BINARY_DIR}/bin/help")

    add_custom_command(
        OUTPUT "${_gen}" "${_doc}" "${_bin}"
        COMMAND ${CMAKE_COMMAND} -E make_directory "${H_DOC_DIR}"
        COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_BINARY_DIR}/bin/help"
        COMMAND "${QHELPGENERATOR_EXE}" "${H_QHP}" -o "${_gen}"
        COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_gen}" "${_doc}"
        COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_gen}" "${_bin}"
        DEPENDS "${H_QHP}"
        COMMENT "Generating help.qch from ${H_QHP}"
        VERBATIM)
    add_custom_target(${TARGET}_qch ALL DEPENDS "${_bin}")
    add_dependencies(${TARGET} ${TARGET}_qch)

    # путь для запуска из IDE (прямые слеши)
    file(TO_CMAKE_PATH "${_bin}" _dev)
    target_compile_definitions(${TARGET} PRIVATE "HELP_QCH_DEV_PATH=\"${_dev}\"")

    message(STATUS "HelpManager[${H_PRODUCT}] qhp: ${H_QHP}")
    message(STATUS "HelpManager[${H_PRODUCT}] qch: ${_gen} -> ${_doc}, ${_bin}")
endfunction()

